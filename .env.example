# LinguaMate AI - Environment Configuration
# NOTE: The application runs 100% OFFLINE without any API key using curated fallback engines.
# Optional free-tier keys can be added below to enable live LLM features.

FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=lingua-mate-ai-secret-key-capstone-2026

# AI Provider Selection: 'offline' (default), 'gemini', 'groq', or 'openai'
AI_PROVIDER=offline

# Optional Free-Tier API Keys:
# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=

# Groq Cloud API Key (Get fast free-tier key from https://console.groq.com/)
GROQ_API_KEY=

# Optional OpenAI / Compatible API Key
OPENAI_API_KEY=
